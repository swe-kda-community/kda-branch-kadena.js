        "shortcut": "pnpm run lint:dependencies",
        "action": "run",
        "subsection": "Quality"
      },
      {
        "name": "lint",
        "desc": "Run all lint checks",
        "shortcut": "pnpm run lint",
        "action": "run",
        "subsection": "Quality"
      },
      {
