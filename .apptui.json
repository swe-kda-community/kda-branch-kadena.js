      {
        "name": "git status",
        "desc": "Show working tree status",
        "shortcut": "git status",
        "action": "run"
      },
      {
        "name": "git log",
        "desc": "Show recent 20 commits",
        "shortcut": "git log --oneline -20",
        "action": "run"
      },
      {
        "name": "git diff",
        "desc": "Show unstaged changes",
        "shortcut": "git diff",
        "action": "run"
      },
      {
        "name": "git push",
        "desc": "Push current branch to remote",
        "shortcut": "git push",
        "action": "run"
      }
