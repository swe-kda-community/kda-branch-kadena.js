{
  "title": "kadena.js — kda-community monorepo",
  "model": "claude-opus-4",
  "version": "v1.0.0",
  "workspace": ".",
  "backend": {
    "type": "websocket",
    "url": "ws://localhost:4242/tui",
    "reconnect_ms": 2000
  },
  "section_order": ["Run", "Build", "Test", "AI Tools", "Kadena CLI", "Workspace", "Git", "App"],
  "commands": {
    "Run": [
      {
        "name": "dev-wallet",
        "desc": "Start Kadena dev wallet (Vite)",
        "shortcut": "pnpm --filter @kadena/dev-wallet dev",
        "action": "run",
        "subsection": "Apps"
      },
      {
        "name": "explorer",
        "desc": "Start block explorer (Next.js)",
        "shortcut": "pnpm --filter @kadena/explorer dev",
        "action": "run",
        "subsection": "Apps"
      },
      {
        "name": "graph",
        "desc": "Start GraphQL API server",
        "shortcut": "pnpm --filter @kadena/graph dev",
        "action": "run",
        "subsection": "Apps"
      },
      {
        "name": "tools",
        "desc": "Start tools web app (Next.js)",
        "shortcut": "pnpm --filter @kadena/tools dev",
        "action": "run",
        "subsection": "Apps"
      },
      {
        "name": "rwa-demo",
