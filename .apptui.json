      {
        "name": "Settings",
        "desc": "Configure auto-accept, LaTeX formatting"
      },
      {
        "name": "Theme",
        "desc": "Switch between dark and light colour scheme"
      },
      {
        "name": "Shortcuts",
        "desc": "View keyboard shortcuts",
        "shortcut": "?"
      },
      {
        "name": "Show/Hide Sidebar",
        "desc": "Toggle the sidebar panel",
        "shortcut": "ctrl+/"
      }
    ]
  },
  "settings": {
    "theme": "dark",
    "colors": {},
    "layout": {
      "sidebar_width_pct": 38,
      "show_activity_graph": true,
      "show_todo_list": true,
      "show_terminals": true,
      "show_lsp": true,
      "show_token_stats": true,
      "show_changes": true,
      "compact_header": false
    },
    "chrome": {
      "border_style": "rounded",
      "icon_set": "unicode",
      "graph_density": "full",
      "input_prompt": "› "
    }
