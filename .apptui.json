        "shortcut": "pnpm run format",
        "action": "run",
        "subsection": "Quality"
      },
      {
        "name": "format src",
        "desc": "Format root-level source files only",
        "shortcut": "pnpm run format:src",
        "action": "run",
        "subsection": "Quality"
      },
      {
        "name": "knip",
        "desc": "Find unused exports / files",
        "shortcut": "pnpm knip",
        "action": "run",
        "subsection": "Quality"
      },
      {
        "name": "changeset",
