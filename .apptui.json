        "shortcut": "pnpm --filter @kadena/agent-skills test",
        "action": "run",
        "subsection": "AI Tools"
      },
      {
        "name": "test kadena-cli",
        "desc": "Test the Kadena CLI",
        "shortcut": "pnpm --filter @kadena/kadena-cli test",
        "action": "run",
        "subsection": "CLI"
      },
      {
        "name": "test client",
        "desc": "Test @kadena/client",
        "shortcut": "pnpm --filter @kadena/client test",
        "action": "run",
        "subsection": "Libs"
      },
      {
        "name": "test explorer",
        "desc": "Test the block explorer",
        "shortcut": "pnpm --filter @kadena/explorer test",
