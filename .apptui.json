        "shortcut": "pnpm changeset",
        "action": "run",
        "subsection": "Release"
      },
      {
        "name": "changeset version",
        "desc": "Bump versions from changesets",
        "shortcut": "pnpm version",
        "action": "run",
        "subsection": "Release"
      },
      {
        "name": "publish",
        "desc": "Publish packages to npm",
        "shortcut": "pnpm publish",
        "action": "run",
        "subsection": "Release"
      },
      {
        "name": "update packages.json",
        "desc": "Re-generate packages.json registry",
        "shortcut": "pnpm run format:pkgs",
        "action": "run",
        "subsection": "Release"
      }
