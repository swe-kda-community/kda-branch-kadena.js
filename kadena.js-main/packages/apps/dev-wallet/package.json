{
  "name": "@kadena/dev-wallet",
  "version": "3.1.0",
  "private": true,
  "description": "Kadena developer wallet",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm run generate-coin-type && pnpm run generate:plugins",
    "build": "pnpm run prebuild && tsc && VITE_BUILD_TIME=$(date -u) vite build",
    "build-dev": "tsc && vite build --mode development --watch",
    "build:e2e": "NODE_ENV=test pnpm run build",
    "build:watch": "pnpm run build && concurrently \"chokidar './src/**' './node_modules/@kadena/**' -s -t 500  --command './node_modules/.bin/vite build' \" \"pnpm run preview --port 4173\"",
    "dev": "VITE_BUILD_TIME=$(date -u) vite --force",
    "dev:chainweaver": "concurrently \"chokidar './src/**' --command './node_modules/.bin/vite build' --initial\" \"pnpm run preview --port 1337\"",
    "generate-coin-type": "cache-sh -i \"node_modules/.kadena/**\" -- \"pactjs contract-generate --contract \\\"coin\\\" --api \\\"https://api.chainweb-community.org/chainweb/0.0/mainnet01/chain/14/pact\\\"\"",
    "generate:plugins": "rimraf public/internal-registry/* && ./scripts/symlink-plugins.ts && ./scripts/generate-plugins-json.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@kadena/chainweaver-pact-console-plugin": "workspace:*",
    "@kadena/chainweaver-wallet-connect-plugin": "workspace:*",
    "@kadena/chainweb-node-client": "workspace:*",
    "@kadena/client": "workspace:*",
    "@kadena/client-utils": "workspace:*",
    "@kadena/cryptography-utils": "workspace:*",
    "@kadena/hd-wallet": "workspace:*",
    "@kadena/kode-icons": "workspace:*",
    "@kadena/kode-ui": "workspace:*",
    "@kadena/pactjs": "workspace:*",
    "@kadena/pactjs-generator": "workspace:*",
    "@scure/bip39": "1.2.1",
    "@tauri-apps/api": "^1.6.0",
    "@vanilla-extract/css": "1.14.2",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "0.5.1",
    "asn1js": "^3.0.7",
    "cbor-web": "^9.0.2",
    "chrome-types": "^0.1.425",
    "classnames": "^2.5.1",
    "ed25519-keygen": "0.4.8",
    "elliptic": "^6.6.1",
    "framer-motion": "^11.18.2",
    "js-yaml": "~4.1.1",
    "react": "^19.2.4",
    "react-aria": "^3.47.0",
    "react-console-emulator": "^5.0.2",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-markdown": "^10.1.0",
    "react-qrcode-logo": "^3.0.0",
    "react-router-dom": "^6.30.3",
    "swr": "^2.4.1",
    "usehooks-ts": "^2.16.0",
    "yup": "^1.7.1",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@kadena-dev/eslint-config": "workspace:*",
    "@kadena-dev/lint-package": "workspace:*",
    "@kadena-dev/shared-config": "workspace:*",
    "@kadena/pactjs-cli": "workspace:*",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@types/elliptic": "^6.4.18",
    "@types/js-yaml": "4.0.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vanilla-extract/vite-plugin": "4.0.17",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "cache-sh": "^1.3.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "rimraf": "~5.0.10",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.21",
    "vite-plugin-static-copy": "^1.0.6",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^3.2.4"
  }
}
