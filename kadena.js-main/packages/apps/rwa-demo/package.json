{
  "name": "@kadena/rwa-demo",
  "version": "2.1.4",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 next build",
    "build:e2e": "NODE_ENV=test pnpm run build",
    "dev": "next dev",
    "generate": "pactjs contract-generate --contract \"coin\" --api \"https://api.testnet.chainweb-community.org/chainweb/0.0/testnet06/chain/0/pact\"",
    "generate:sdk": "cache-sh -i \"{codegen-sdk.yml,./node_modules/@kadena/graph/generated-schema.graphql,src/**/*.graph.ts,src/__generated__/**}\" -- graphql-codegen --config codegen-sdk.yml",
    "lint": "pnpm run /^lint:.*/",
    "lint:fmt": "prettier . --cache --check",
    "lint:src": "eslint src",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "browserslist": [
    "defaults and supports es6-module",
    "not dead",
    "not IE 11"
  ],
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@google-analytics/data": "~3.2.2",
    "@graphql-yoga/apollo-link": "~3.3.1",
    "@hookform/resolvers": "^3.10.0",
    "@kadena/client": "workspace:*",
    "@kadena/client-utils": "workspace:*",
    "@kadena/cryptography-utils": "workspace:*",
    "@kadena/graph": "workspace:*",
    "@kadena/kode-icons": "workspace:*",
    "@kadena/kode-ui": "workspace:*",
    "@kadena/pactjs": "workspace:*",
    "@kadena/spirekey-sdk": "^1.0.1",
    "@kadena/wallet-adapter-chainweaver": "workspace:*",
    "@kadena/wallet-adapter-core": "workspace:*",
    "@kadena/wallet-adapter-ecko": "workspace:*",
    "@kadena/wallet-adapter-magic": "workspace:*",
    "@kadena/wallet-adapter-react": "workspace:*",
    "@kadena/wallet-adapter-walletconnect": "workspace:*",
    "@magic-ext/kadena": "^0.11.0",
    "@sentry/nextjs": "^10.46.0",
    "@sentry/tracing": "^7.120.4",
    "@vanilla-extract/css": "1.14.2",
    "@vanilla-extract/css-utils": "^0.1.6",
    "@vanilla-extract/next-plugin": "^2.5.1",
    "@vanilla-extract/recipes": "0.5.1",
    "@vanilla-extract/sprinkles": "1.6.1",
    "cache-sh": "^1.3.1",
    "classnames": "^2.5.1",
    "firebase": "^10.14.1",
    "firebase-admin": "^13.7.0",
    "form-data": "^4.0.5",
    "graphql": "~16.8.2",
    "graphql-ws": "^5.16.2",
    "magic-sdk": "^28.21.1",
    "mailgun.js": "^12.7.1",
    "next": "~15.4.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.2",
    "@graphql-codegen/typescript-operations": "~4.2.3",
    "@graphql-codegen/typescript-react-apollo": "~4.3.4",
    "@kadena-dev/eslint-config": "workspace:*",
    "@kadena-dev/lint-package": "workspace:*",
    "@kadena-dev/shared-config": "workspace:*",
    "@kadena/pactjs": "workspace:*",
    "@kadena/pactjs-cli": "workspace:*",
    "@kadena/pactjs-generator": "workspace:*",
    "@sentry/types": "^9.47.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "~16.3.2",
    "@types/gtag.js": "~0.0.20",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "4.0.17",
    "@vanilla-extract/webpack-plugin": "2.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "13.4.5",
    "happy-dom": "^12.10.3",
    "next-router-mock": "^0.9.13",
    "prettier": "~3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vitest-dom": "^0.1.1"
  }
}
