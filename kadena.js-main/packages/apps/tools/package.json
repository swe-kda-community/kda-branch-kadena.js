{
  "name": "@kadena/tools",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "build": "pnpm run generate:contracts && next build",
    "build:e2e": "pnpm run generate:contracts && NODE_ENV=test next build",
    "dev": "next dev",
    "format": "pnpm run --sequential /^format:.*/",
    "format:lint": "pnpm run lint:src --fix",
    "format:md": "remark README.md -o --use @kadena-dev/markdown",
    "format:src": "prettier . --cache --write",
    "generate:coin:contract": "pactjs contract-generate --contract coin --api https://api.chainweb-community.org/chainweb/0.0/mainnet01/chain/1/pact --chain 1 --network testnet",
    "generate:contracts": "pnpm run /^generate:.*:contract/",
    "generate:faucet:contract": "pactjs contract-generate --namespace n_d8cbb935f9cd9d2399a5886bb08caed71f9bad49 -f ../../libs/client-utils/src/scripts/deploy-faucet/testnet-faucet.pact",
    "lint": "pnpm run /^lint:.*/",
    "lint:fmt": "prettier . --cache --check",
    "lint:pkg": "lint-package",
    "lint:src": "eslint src --ext .ts,.tsx",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run generate:contracts && tsc --noEmit"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.19.1",
    "@hookform/resolvers": "^3.10.0",
    "@kadena/chainweb-node-client": "workspace:*",
    "@kadena/client": "workspace:*",
    "@kadena/client-utils": "workspace:*",
    "@kadena/cryptography-utils": "workspace:*",
    "@kadena/fonts": "~0.0.1",
    "@kadena/kode-icons": "workspace:*",
    "@kadena/kode-ui": "workspace:*",
    "@kadena/pactjs": "workspace:*",
    "@kadena/pactjs-generator": "workspace:*",
    "@ledgerhq/hw-transport": "^6.34.1",
    "@ledgerhq/hw-transport-webhid": "^6.34.0",
    "@ledgerhq/logs": "^6.16.0",
    "@tanstack/react-query": "^5.95.2",
    "@vanilla-extract/css": "1.14.2",
    "@walletconnect/modal": "~2.7.0",
    "@walletconnect/sign-client": "~2.8.6",
    "@walletconnect/utils": "^2.23.9",
    "ace-builds": "~1.30.0",
    "classnames": "^2.5.1",
    "date-fns": "~2.30.0",
    "fuse.js": "^7.1.0",
    "http-proxy-middleware": "^2.0.9",
    "hw-app-kda-clone": "workspace:*",
    "js-cookie": "~3.0.5",
    "next": "~15.4.11",
    "next-recaptcha-v3": "^1.5.3",
    "next-themes": "^0.4.6",
    "next-translate": "~2.0.6",
    "react": "^19.2.4",
    "react-ace": "^11.0.1",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-use": "^17.6.0",
    "viem": "^2.47.6",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@kadena-dev/eslint-config": "workspace:*",
    "@kadena-dev/lint-package": "workspace:*",
    "@kadena-dev/markdown": "workspace:*",
    "@kadena-dev/shared-config": "workspace:*",
    "@kadena/pactjs-cli": "workspace:*",
    "@kadena/types": "workspace:*",
    "@rushstack/eslint-config": "~3.6.10",
    "@rushstack/heft": "~0.50.7",
    "@tanstack/eslint-plugin-query": "^5.95.2",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.5.2",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/debug": "~4.1.13",
    "@types/js-cookie": "~3.0.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/next-plugin": "^2.5.1",
    "@vanilla-extract/vite-plugin": "4.0.17",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@walletconnect/types": "~2.8.6",
    "@webpro/next-translate-plugin": "^2.6.3",
    "debug": "4.3.4",
    "dotenv": "~16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "13.4.5",
    "happy-dom": "^12.10.3",
    "next-router-mock": "^0.9.13",
    "prettier": "~3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vitest-dom": "^0.1.1"
  },
  "packageManager": "pnpm@9.5.0",
  "volta": {
    "node": "16.15.0"
  }
}
