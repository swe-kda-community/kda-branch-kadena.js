# SpireKey wallet host (embedded WebAuthn wallet)
# Live:  https://chainweaver.kadena.io  (default)
# Local: http://localhost:1337
VITE_SPIREKEY_HOST=https://chainweaver.kadena.io

# Kadena network
# testnet06 — KDA Community Edition testnet (active as of Feb 2026)
# testnet04 was abandoned / broken — do NOT use
# Options: testnet06 | mainnet01 | development
VITE_NETWORK_ID=testnet06

# Default chain (0–19)
VITE_CHAIN_ID=1

# Chainweb node base URL
# testnet06: https://api.testnet.chainweb-community.org
# Mainnet:   https://api.chainweb.com
# Devnet:    http://localhost:8080
VITE_CHAINWEB_API_BASE=https://api.testnet.chainweb-community.org
