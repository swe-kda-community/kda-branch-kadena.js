# SpireKey host — the embedded wallet / SpireKey instance
# Default: https://chainweaver.kadena-community.org
# Local:   http://localhost:1337
VITE_SPIREKEY_HOST=https://chainweaver.kadena-community.org

# Kadena network to connect to
# Options: mainnet01 | testnet06 | development
VITE_NETWORK_ID=testnet06

# Default chain ID (0–19)
VITE_CHAIN_ID=14

# Chainweb node base URL — used for submitting and polling transactions
# Testnet:  https://api.testnet.chainweb-community.org
# Mainnet:  https://api.chainweb-community.org
# Devnet:   http://localhost:8080
VITE_CHAINWEB_API_BASE=https://api.testnet.chainweb-community.org
VITE_FAUCET_API_BASE=https://faucet.testnet.chainweb-community.org
