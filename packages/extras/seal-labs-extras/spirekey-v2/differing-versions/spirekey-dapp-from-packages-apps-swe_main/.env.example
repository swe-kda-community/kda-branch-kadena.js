# SpireKey host — the embedded wallet / SpireKey instance
# Default: https://chainweaver.kadena.io (Kadena-hosted SpireKey)
# Local:   http://localhost:1337
VITE_SPIREKEY_HOST=https://chainweaver.kadena.io

# Kadena network to connect to
# Options: mainnet01 | testnet04 | development
VITE_NETWORK_ID=testnet04

# Default chain ID (0–19)
VITE_CHAIN_ID=14

# Chainweb node base URL — used for submitting and polling transactions
# Testnet:  https://api.testnet.chainweb.com
# Mainnet:  https://api.chainweb.com
# Devnet:   http://localhost:8080
VITE_CHAINWEB_API_BASE=https://api.testnet.chainweb.com
