{
  "name": "@kadena/wallet-adapter-metamask-snap",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kadena-community/kadena.js.git",
    "directory": "packages/libs/wallet-adapter-metamask-snap"
  },
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && api-extractor run",
    "format": "prettier . --cache --write",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@kadena/client": "workspace:*",
    "@kadena/types": "workspace:*",
    "@kadena/wallet-adapter-core": "workspace:*",
    "@metamask/providers": "^22.1.1"
  },
  "devDependencies": {
    "@kadena-dev/eslint-config": "workspace:*",
    "@microsoft/api-extractor": "^7.57.7",
    "@rushstack/eslint-config": "~3.6.10",
    "eslint": "^8.57.1",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "authors": [
    "Francisco Miranda",
    "Ariel Serranoni"
  ]
}
