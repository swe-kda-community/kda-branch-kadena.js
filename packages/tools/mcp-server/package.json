{
  "name": "@kadena/mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing Kadena blockchain tools to AI assistants",
  "keywords": [
    "kadena",
    "mcp",
    "model-context-protocol",
    "ai",
    "blockchain"
  ],
  "license": "BSD-3-Clause",
  "type": "module",
  "bin": {
    "kadena-mcp": "./dist/server.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/server.js",
    "dev": "node --watch dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kadena/ai-tools": "workspace:*",
    "@kadena/client": "workspace:*",
    "@kadena/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@kadena-dev/eslint-config": "workspace:*",
    "@kadena-dev/shared-config": "workspace:*",
    "@rushstack/eslint-config": "~3.6.10",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kadena-community/kadena.js.git",
    "directory": "packages/tools/mcp-server"
  }
}
